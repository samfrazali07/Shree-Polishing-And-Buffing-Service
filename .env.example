# ---------------------------------------------------------------
# Copy this file to .env (local) or add these in your hosting
# provider's environment variable settings (e.g. Vercel).
# NEVER commit real secrets to git.
# ---------------------------------------------------------------

# ---- Public (frontend, safe to expose) ----
# Leave blank until verified. Address/hours/maps already have verified defaults in src/config/site.ts
VITE_BUSINESS_EMAIL=
# Optional overrides (defaults are already set for Jaipur address & 24h hours):
# VITE_BUSINESS_ADDRESS=E 329, Jhilaya House Gali, No. 1, Old Amer Road, Jaipur, Rajasthan 302002, India
# VITE_BUSINESS_HOURS=Open 24 hours, every day
# VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=E%20329%20Jhilaya%20House%20Gali%20No.%201%20Old%20Amer%20Rd%20Jaipur%20Rajasthan%20302002
VITE_GOOGLE_REVIEWS_URL=

# ---- Server only (serverless functions in /api) ----
# Google Places API (New). Restrict this key to the Places API and your server IPs/referrers.
GOOGLE_PLACES_API_KEY=
# Place ID of the verified Google Business Profile for Shree Polishing And Buffing Service.
GOOGLE_PLACE_ID=

# Supabase (feedback and enquiry storage). Use the service role key on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign in at /admin for moderation.
ADMIN_TOKEN=
